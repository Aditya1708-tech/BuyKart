# MongoDB Atlas Connection
MONGODB_URI=
MONGODB_DB_NAME=buykart

# Backend Port Configuration
# API_PORT is used for local development, PORT is provided dynamically by Render in production
API_PORT=5000
PORT=

# Production Frontend URL for CORS (e.g. https://your-buykart.vercel.app)
CLIENT_URL=

# Frontend API Base URL (used by Vite frontend)
# Local development: http://localhost:5000
# Production: Deployed Render backend URL (e.g. https://buykart-api.onrender.com)
VITE_API_URL=http://localhost:5000
